# Maintainer: ProfetGit
pkgname=deckhand-git
_name=deckhand
pkgver=1.0.0
pkgrel=1
pkgdesc="A modern Stream Deck studio for Linux"
arch=(any)
url="https://github.com/ProfetGit/deckhand"
license=(MIT)
depends=(python python-pyqt6 hidapi)
makedepends=(git python-build python-installer python-setuptools python-wheel)
optdepends=('wl-clipboard: the Type Text action'
            'libpulse: microphone and speaker mute, audio devices (pactl)'
            'spectacle: the Screenshot action'
            'libkscreen: the Toggle Monitor action (kscreen-doctor)'
            'konsole: show a command in a terminal window'
            'qt6-multimedia: timer sounds without an external player')
provides=(deckhand)
conflicts=(deckhand)
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  printf '%s' "$(sed -n 's/^VERSION = "\(.*\)"/\1/p' deckhand/agentapi.py)"
}

build() {
  cd "$_name"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_name"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/deckhand.desktop "$pkgdir/usr/share/applications/deckhand.desktop"
  install -Dm644 deckhand/assets/deckhand.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/deckhand.svg"
  install -Dm644 packaging/io.github.ProfetGit.Deckhand.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.ProfetGit.Deckhand.metainfo.xml"
  install -Dm644 packaging/70-deckhand-streamdeck.rules "$pkgdir/usr/lib/udev/rules.d/70-deckhand-streamdeck.rules"
  install -Dm644 packaging/70-deckhand-uinput.rules "$pkgdir/usr/lib/udev/rules.d/70-deckhand-uinput.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
